# =====================================================================
# PollTech Radar - Production Environment Configuration
# Location: /etc/radar/radar.env
# Permissions: chmod 0640 /etc/radar/radar.env (root:radar)
# =====================================================================

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# PostgreSQL Database (Native TCP connection via pg driver)
DATABASE_URL=postgresql://radar_user:REPLACE_WITH_SECURE_PASSWORD@127.0.0.1:5432/radar_prod

# Session secret for web UI cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=REPLACE_WITH_HEX_SESSION_SECRET

# PollTech Thin-Fork REST API Integration Key (min 32 characters)
INTEGRATION_KEY=rad_sec_REPLACE_WITH_SECURE_INTEGRATION_KEY
# Optional fallback for zero-downtime key rotation:
# INTEGRATION_KEY_PREVIOUS=

# Connectors
ENABLE_WEB_CONNECTOR=true

# AI Provider (Optional: anthropic | openai | grok | azure)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Public App URL (Used in links and reports)
APP_URL=https://radar.polltech.internal
NEXT_PUBLIC_APP_URL=https://radar.polltech.internal
